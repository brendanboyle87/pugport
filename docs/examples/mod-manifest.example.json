{
  "schemaVersion": 1,
  "id": "example.reading-notes",
  "version": "1.0.0",
  "title": "Reading notes reference panel",
  "description": "Saves reading goals and notes and fills them into an ordinary chat when you want. This file is a development template, not a store listing.",
  "author": "Example author",
  "category": "Learning",
  "icon": "book-open",
  "cover": {
    "src": "data:image/webp;base64,",
    "alt": "Default cover illustration made of light, blue and dark blocks"
  },
  "readme": "# Purpose\n\nSave this project chat's reading goals and notes.\n\n## How to use\n\n1. Load this package in the Mods Store. Loading does not switch chats or start a task.\n2. Open a project chat and choose this package from the Mod menu at the top.\n3. Fill in your goal and notes, then select Save.\n4. When you want to discuss them, select Send to chat, check the draft and send it yourself.\n\n## Data and permissions\n\nFields are stored only in the local instance for the current project chat. Loading and saving call no model and gain no extra tool permissions. Saved content stays after the package is unloaded.\n\n## Version notes\n\n1.0.0: development template. Before publishing, replace this with your own description and a cover you have the right to use. homepage is only a format example; remove the field if there is no real web page.",
  "view": {
    "markdown": "Write down your current reading goal and notes.",
    "fields": [
      {
        "id": "goal",
        "label": "Reading goal",
        "type": "text",
        "initialValue": ""
      },
      {
        "id": "notes",
        "label": "My notes",
        "type": "textarea",
        "initialValue": ""
      }
    ],
    "actions": [
      {
        "id": "save",
        "label": "Save notes",
        "type": "save"
      },
      {
        "id": "discuss",
        "label": "Send to chat",
        "type": "compose",
        "prompt": "Based on the reading goal and notes below, help me clear up the parts I do not understand."
      }
    ]
  },
  "homepage": "https://example.com/mods/reading-notes"
}
